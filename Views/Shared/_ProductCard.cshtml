@model TP_Product.Models.Product

@{
    var photoPath = "~/images/" + (Model.Image ?? "noimage.jpg");
    bool enStock = Model.QteStock > 0;
}

<article class="product-card @(enStock ? "" : "is-out")"
         data-href="@Url.Action("Details", "Product", new { id = Model.ProductId })">
    <div class="product-photo">
        <img src="@photoPath" asp-append-version="true" alt="@Model.Name" loading="lazy" />

        @if (!enStock)
        {
            <span class="badge bg-danger product-stock">Rupture de stock</span>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="product-admin">
                <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.ProductId"
                   class="btn btn-sm btn-light" title="Modifier"><i class="bi bi-pencil"></i></a>
                <a asp-controller="Product" asp-action="Delete" asp-route-id="@Model.ProductId"
                   class="btn btn-sm btn-light text-danger" title="Supprimer"><i class="bi bi-trash"></i></a>
            </div>
        }
    </div>

    <div class="product-body">
        <span class="product-category">@Model.Category.CategoryName</span>
        <h3 class="product-name">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId">@Model.Name</a>
        </h3>
        <div class="price-tag mb-2">@Model.Price.ToString("0.00") <small>DT</small></div>

        @if (enStock)
        {
            <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@Model.ProductId"
               class="btn btn-success w-100">
                <i class="bi bi-cart-plus me-1"></i>Ajouter au panier
            </a>
        }
        else
        {
            <button class="btn btn-secondary w-100" disabled>Indisponible</button>
        }
    </div>
</article>
