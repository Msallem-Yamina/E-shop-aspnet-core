@{
    int totalPages = ViewBag.TotalPages ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
}

@if (totalPages > 1)
{
    <nav class="mt-4" aria-label="Pagination des produits">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-categoryId="@ViewBag.CategoryId"
                   asp-route-page="@(currentPage - 1)" asp-fragment="articles">&laquo;</a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-categoryId="@ViewBag.CategoryId"
                       asp-route-page="@i" asp-fragment="articles">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-categoryId="@ViewBag.CategoryId"
                   asp-route-page="@(currentPage + 1)" asp-fragment="articles">&raquo;</a>
            </li>
        </ul>
    </nav>
}
