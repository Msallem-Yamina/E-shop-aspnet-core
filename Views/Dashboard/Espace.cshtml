@{
    ViewData["Title"] = "Tableau de bord";
    bool peutGerer = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<h1 class="page-title mb-1">Tableau de bord</h1>
<p class="text-muted mb-4">Bienvenue, <b>@User.Identity.Name</b>.</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    <div class="col">
        <a asp-controller="Panier" asp-action="MesCommandes" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-bag-check text-primary" style="font-size:2.5rem"></i>
                <h5 class="mt-2 mb-0 text-body">Mes commandes</h5>
                <small class="text-muted">Consulter l'historique de mes achats</small>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-controller="Panier" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-cart3 text-success" style="font-size:2.5rem"></i>
                <h5 class="mt-2 mb-0 text-body">Mon panier</h5>
                <small class="text-muted">Voir les articles en attente</small>
            </div>
        </a>
    </div>

    @if (peutGerer)
    {
        <div class="col">
            <a asp-controller="Product" asp-action="Create" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <i class="bi bi-plus-circle text-warning" style="font-size:2.5rem"></i>
                    <h5 class="mt-2 mb-0 text-body">Nouvel article</h5>
                    <small class="text-muted">Ajouter un produit au catalogue</small>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Category" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <i class="bi bi-tags text-info" style="font-size:2.5rem"></i>
                    <h5 class="mt-2 mb-0 text-body">Catégories</h5>
                    <small class="text-muted">Gérer les catégories</small>
                </div>
            </a>
        </div>
    }
</div>