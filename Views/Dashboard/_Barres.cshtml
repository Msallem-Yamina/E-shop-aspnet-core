@model List<TP_Product.ViewModels.StatLigne>

@{
    int max = Model.Count > 0 ? Model.Max(l => l.Valeur) : 0;
}

@if (max == 0)
{
    <p class="text-muted mb-0">Aucune donnée pour le moment.</p>
}
else
{
    foreach (var ligne in Model)
    {
        <div class="stat-bar-row" title="@ligne.Label : @ligne.Valeur">
            <div class="d-flex justify-content-between gap-2 small">
                <span class="text-truncate">@ligne.Label</span>
                <b>@ligne.Valeur</b>
            </div>
            <div class="stat-bar-track">
                <div class="stat-bar" style="width:@(ligne.Valeur * 100 / max)%"></div>
            </div>
        </div>
    }
}
