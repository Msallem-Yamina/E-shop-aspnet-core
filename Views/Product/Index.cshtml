@model IEnumerable<TP_Product.Models.Product>

@{
    ViewData["Title"] = "Liste des produits";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="page-title mb-0">
            @(ViewBag.CategoryName != null ? (string)ViewBag.CategoryName : "Tous les articles")
        </h1>
        @if (Model.Any())
        {
            <small class="text-muted">@Model.Count() article(s) affiché(s)</small>
        }
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-success btn-lg">+ Nouvel article</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state text-center mb-5">
        <div class="empty-icon"><i class="bi bi-box-seam"></i></div>
        <h3 class="mt-3">Aucun article trouvé</h3>
        <p class="text-muted mb-4">
            @if (ViewBag.CategoryName != null)
            {
                <text>La catégorie <b>@ViewBag.CategoryName</b> ne contient pas encore d'article.</text>
            }
            else
            {
                <text>Aucun article ne correspond à votre recherche.</text>
            }
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-action="Index" class="btn btn-primary">
                <i class="bi bi-collection me-1"></i>Voir tous les articles
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-lg me-1"></i>Ajouter un article
                </a>
            }
        </div>
    </div>
}

<div class="product-grid">
    @foreach (var product in Model)
    {
        <partial name="_ProductCard" model="product" />
    }
</div>

<partial name="_Pagination" />
