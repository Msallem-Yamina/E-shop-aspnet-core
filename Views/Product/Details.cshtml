@model TP_Product.Models.Product

@{
    ViewData["Title"] = "Details";
    var photoPath = "~/images/" + (Model.Image ?? "noimage.jpg");
    bool peutModifier = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="card shadow border-0 mx-auto" style="max-width: 800px;">
    <div class="row g-0">
        <div class="col-md-5 d-flex align-items-center bg-white">
            <img src="@photoPath" asp-append-version="true" class="img-fluid p-3" alt="@Model.Name" />
        </div>
        <div class="col-md-7">
            <div class="card-body p-4">
                <span class="badge bg-secondary mb-2">@Model.Category.CategoryName</span>
                <h2 class="card-title">@Model.Name</h2>
                <p class="price-tag text-primary fs-2 mb-2">@Model.Price.ToString("0.00") DT</p>

                <p class="mb-4">
                    @if (Model.QteStock > 10)
                    {
                        <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>En stock : @Model.QteStock unités</span>
                    }
                    else if (Model.QteStock > 0)
                    {
                        <span class="badge bg-warning text-dark fs-6"><i class="bi bi-exclamation-triangle me-1"></i>Stock faible : @Model.QteStock unités</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Rupture de stock</span>
                    }
                </p>

                <div class="d-grid gap-2 mb-3">
                    @if (Model.QteStock > 0)
                    {
                        <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@Model.ProductId"
                           class="btn btn-success btn-lg">
                            <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg" disabled>
                            <i class="bi bi-cart-x me-2"></i>Indisponible
                        </button>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Retour à la liste
                    </a>
                    @if (peutModifier)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Modifier
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>