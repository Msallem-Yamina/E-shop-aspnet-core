@using TP_Product.Models.Help
@{
    ViewData["Title"] = "Mon panier";
    List<CartLine> liste = (List<CartLine>)ViewBag.Liste;
}

<h1 class="page-title mb-4"><i class="bi bi-cart3 me-2"></i>Mon panier</h1>

@if (liste.Count > 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:130px">Produit</th>
                        <th>Description</th>
                        <th class="text-center">Quantité</th>
                        <th class="text-end">Prix unitaire</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in liste)
                    {
                        <tr id="row-@item.Prod.ProductId">
                            <td>
                                <img src="~/images/@(item.Prod.Image ?? "noimage.jpg")" alt="@item.Prod.Name"
                                     class="rounded border p-1 bg-white" style="width:100px;height:100px;object-fit:contain" />
                            </td>
                            <td>
                                <h5 class="mb-1">@item.Prod.Name</h5>
                                <span class="badge bg-secondary">@item.Prod.Category.CategoryName</span>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <a href="#" class="btn btn-sm btn-outline-secondary MinProducts"
                                       data-id="@item.Prod.ProductId" title="Retirer un">
                                        <i class="bi bi-dash-lg"></i>
                                    </a>
                                    <span class="fw-bold fs-5" id="quantite_@item.Prod.ProductId">@item.quantite</span>
                                    <a href="#" class="btn btn-sm btn-outline-secondary PlusProducts"
                                       data-id="@item.Prod.ProductId" title="Ajouter un">
                                        <i class="bi bi-plus-lg"></i>
                                    </a>
                                </div>
                            </td>
                            <td class="text-end">@item.UnitPrice.ToString("0.00") DT</td>
                            <td class="text-end fw-bold">
                                <span id="total_@item.Prod.ProductId">@item.TotalPrice.ToString("0.00")</span> DT
                            </td>
                            <td class="text-end">
                                <a href="#" class="btn btn-sm btn-outline-danger RemoveLink" data-id="@item.Prod.ProductId"
                                   title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Continuer mes achats
        </a>
        <div class="text-end">
            <h4 class="mb-2">Total à payer : <span id="totalapayer"
                                                       class="text-primary">@(((decimal)ViewBag.total).ToString("0.00"))</span> DT</h4>
                <a asp-controller="Panier" asp-action="Checkout" class="btn btn-success btn-lg">
                    Commander <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
else
    {
        <div class="text-center mt-5">
            <i class="bi bi-cart-x text-muted" style="font-size:6rem"></i>
            <h3 class="mt-3 text-muted">Votre panier est vide !</h3>
            <p class="text-muted">Partez à la découverte de nos produits et faites-vous plaisir.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Voir les produits</a>
        </div>
    }