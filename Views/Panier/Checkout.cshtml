@model TP_Product.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "Passer la commande";
}

<h1 class="page-title mb-4"><i class="bi bi-bag-check me-2"></i>Passer la commande</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row g-4">
    <!-- Récapitulatif du panier -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">Votre panier</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Quantité</th>
                            <th class="text-end">Prix unitaire</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("0.00") DT</td>
                                <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("0.00")) DT</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Montant total</td>
                            <td class="text-end fw-bold text-primary fs-5">@Model.TotalAmount.ToString("0.00") DT</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Formulaire de livraison -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">Livraison et paiement</div>
            <div class="card-body p-4">
                <form asp-action="Checkout" method="post">
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Adresse de livraison</label>
                        <input asp-for="Address" class="form-control" placeholder="Rue, ville, code postal" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="PaymentMethod" class="form-label">Méthode de paiement</label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="CreditCard">Carte de crédit</option>
                            <option value="Paypal">PayPal</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Retour au panier</a>
                        <button type="submit" class="btn btn-success">Passer la commande</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>