@model IEnumerable<TP_Product.Models.Order>

@{
    ViewData["Title"] = "Mes commandes";
}

<h1 class="page-title mb-4"><i class="bi bi-bag-check me-2"></i>Mes commandes</h1>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <i class="bi bi-bag-x text-muted" style="font-size:6rem"></i>
        <h3 class="mt-3 text-muted">Vous n'avez pas encore de commande.</h3>
        <p class="text-muted">Vos commandes apparaîtront ici après votre premier achat.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Voir les produits</a>
    </div>
}
else
{
    foreach (var order in Model)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-bold">Commande #@order.Id</span>
                <span>@order.OrderDate.ToString("dd/MM/yyyy à HH:mm")</span>
            </div>

            <div class="card-body pb-0">
                <p class="mb-2">
                    <i class="bi bi-geo-alt me-1"></i><b>Livraison :</b> @order.Address
                </p>
            </div>

            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th class="text-center">Qté</th>
                        <th class="text-end">Prix</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@((item.Price * item.Quantity).ToString("0.00")) DT</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-end fw-bold">Montant total</td>
                        <td class="text-end fw-bold text-primary fs-5">@order.TotalAmount.ToString("0.00") DT</td>
                    </tr>
                </tfoot>
            </table>

            <div class="card-footer bg-white text-end">
                <a asp-controller="Panier" asp-action="Confirmation" asp-route-orderId="@order.Id"
                   class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-eye me-1"></i>Voir le détail
                </a>
            </div>
        </div>
    }
}